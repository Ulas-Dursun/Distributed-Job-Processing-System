# Application mode: "all" (monolith), "api" (HTTP only), or "worker" (queue processor only)
APP_MODE=all
SERVER_PORT=8080

# PostgreSQL Connection
DATABASE_URL=postgres://queueuser:queuepass@localhost:5432/queueforge?sslmode=disable

# Redis Connection
REDIS_URL=redis://localhost:6379

# Worker Pool Configuration
WORKER_COUNT=5
MAX_RETRIES=3

# Security override (set true ONLY for running local unit/mock tests)
ALLOW_LOCAL_FETCH=false
